@page "/Inventory"
@model Warehouse.Pages.InventoryModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Inventory</h1>
        <p class="text-secondary mb-0 small">Overview of current inventory</p>
    </div>
    <a asp-page="/Inventory/Create" class="btn btn-warning text-dark fw-semibold">
        <i class="bi bi-plus-lg"></i> Add Item
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 p-2">
                    <i class="bi bi-boxes text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-secondary small">Total Items</div>
                    <div class="fs-4 fw-semibold">@Model.allItems</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger bg-opacity-10 p-2">
                    <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                </div>
                <div>
                    <div class="text-secondary small">Low Stock</div>
                    <div class="fs-4 fw-semibold">@Model.lowStock</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success bg-opacity-10 p-2">
                    <i class="bi bi-currency-dollar text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-secondary small">Inventory Value</div>
                    <div class="fs-4 fw-semibold">@Model.invValue.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info bg-opacity-10 p-2">
                    <i class="bi bi-clock-history text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-secondary small">Last Added</div>
                    <div class="fs-6 fw-semibold">@Model.lastCreate.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-4 text-secondary"></i>
        <p class="text-secondary mt-3 mb-0">No inventory items found.</p>
        <a asp-page="/Inventory/Create" class="btn btn-warning text-dark fw-semibold mt-3">
            <i class="bi bi-plus-lg"></i> Add your first item
        </a>
    </div>
}
else
{
    <div class="card bg-dark border-secondary-subtle">
        <div class="table-responsive">
            <table id="inventoryTable" class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>ID</th>
                        <th>Name</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Created By</th>
                        <th>Created Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.items)
                    {
                        <tr>
                            <td class="text-secondary">
                                #@item.id
                            </td>

                            <td class="fw-medium">
                                @item.name
                            </td>

                            <td>
                                @if (item.quantity <= 5)
                                {
                                    <span class="badge bg-danger bg-opacity-75">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        @item.quantity left
                                    </span>
                                }
                                else
                                {
                                    <span>@item.quantity</span>
                                }
                            </td>

                            <td>
                                @item.price.ToString("C")
                            </td>

                            <td>
                                @item.createby
                            </td>

                            <td class="text-secondary">
                                @item.createdate.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {

    <script>
        new DataTable('#inventoryTable');
    </script>

}