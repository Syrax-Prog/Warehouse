@page "/Inventory"
@model Warehouse.Pages.InventoryModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Inventory</h1>
        <p class="text-secondary mb-0 small">Overview of current inventory</p>
    </div>

    <button type="button" class="btn btn-warning text-dark fw-semibold" data-bs-toggle="modal" data-bs-target="#addItemModal">
        <i class="bi bi-plus-lg"></i> Add Item
    </button>
</div>


<div class="row g-3 mb-4">

    <!-- Total Items -->
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">

                <div class="rounded-3 bg-warning bg-opacity-10 p-2">
                    <i class="bi bi-boxes text-warning fs-4"></i>
                </div>

                <div>
                    <div class="text-secondary small">Total Items</div>
                    <div class="fs-4 fw-semibold">@Model.allItems</div>
                </div>

            </div>
        </div>
    </div>


    <!-- Low Stock -->
    <div class="col-sm-6 col-lg-3">
        <a asp-page="/Inventory/Inventory" asp-route-filter="lowstock" class="text-decoration-none text-light d-block h-100">

            <div class="card bg-dark border-secondary-subtle h-100">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="rounded-3 bg-danger bg-opacity-10 p-2">
                        <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                    </div>

                    <div>
                        <div class="text-secondary small">Low Stock</div>
                        <div class="fs-4 fw-semibold">@Model.lowStock</div>
                    </div>

                </div>
            </div>

        </a>
    </div>


    <!-- Inventory Value -->
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">

                <div class="rounded-3 bg-success bg-opacity-10 p-2">
                    <i class="bi bi-currency-dollar text-success fs-4"></i>
                </div>

                <div>
                    <div class="text-secondary small">Inventory Value</div>
                    <div class="fs-4 fw-semibold">
                        @Model.invValue.ToString("C")
                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- Last Added -->
    <div class="col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary-subtle h-100">
            <div class="card-body d-flex align-items-center gap-3">

                <div class="rounded-3 bg-info bg-opacity-10 p-2">
                    <i class="bi bi-clock-history text-info fs-4"></i>
                </div>

                <div>
                    <div class="text-secondary small">Last Added</div>
                    <div class="fs-6 fw-semibold">
                        @Model.lastCreate.ToString("dd MMM yyyy")
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

@if (HttpContext.Session.GetString("Message") != null)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>
            @HttpContext.Session.GetString("Message")
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    HttpContext.Session.Remove("Message");
}

@if (!Model.items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-4 text-secondary"></i>
        <p class="text-secondary mt-3 mb-0">No inventory items found.</p>
        <a asp-page="/Inventory/Create" class="btn btn-warning text-dark fw-semibold mt-3">
            <i class="bi bi-plus-lg"></i> Add your first item
        </a>
    </div>
}
else
{
    <div class="card bg-dark border-secondary-subtle">
        <div class="table-responsive">
            <table id="inventoryTable" class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>ID</th>
                        <th>Name</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Created By</th>
                        <th>Created Date</th>
                        <th>Updated By</th>
                        <th>Updated Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.items)
                    {
                        <tr>
                            <td class="text-secondary">
                                #@item.id
                            </td>

                            <td class="fw-medium">
                                @item.name
                            </td>

                            <td>
                                @if (item.quantity <= 5)
                                {
                                    <span class="badge bg-danger bg-opacity-75">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        @item.quantity left
                                    </span>
                                }
                                else
                                {
                                    <span>@item.quantity</span>
                                }
                            </td>

                            <td>
                                @item.price.ToString("C")
                            </td>

                            <td>
                                @item.createby
                            </td>

                            <td class="text-secondary">
                                @item.createdate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.updateby
                            </td>

                            <td class="text-secondary">
                                @item.updatedate.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-warning me-1" data-bs-toggle="modal"
                                        data-bs-target="#editItemModal" data-id="@item.id" data-name="@item.name"
                                        data-quantity="@item.quantity" data-price="@item.price" data-updateby="@item.updateby">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </button>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this item?');">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Edit Item Modal -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-warning border-2">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="editItemModalLabel">
                    <i class="bi bi-box-seam text-warning me-2"></i>
                    Edit Item
                </h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" id="editItemId" name="id" />
                    <div class="mb-3">
                        <label for="editItemName" class="form-label">Item Name</label>
                        <input type="text" id="editItemName" name="name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="editItemQuantity" class="form-label">Quantity</label>
                        <input type="number" id="editItemQuantity" name="quantity" class="form-control" min="0"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="editItemPrice" class="form-label">price</label>
                        <div class="input-group">
                            <span class="input-group-text">RM</span>
                            <input type="number" id="editItemPrice" name="price" class="form-control" min="0"
                                   step="0.01" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-warning text-dark fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Item Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-warning border-2">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="addItemModalLabel">
                    <i class="bi bi-box-seam text-warning me-2"></i>
                    Add Item
                </h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close">
                </button>

            </div>

            <form method="post" asp-page-handler="Add">
                <div class="modal-body">
                    <!-- Item Name -->
                    <div class="mb-3">
                        <label for="addItemName" class="form-label">Item Name</label>
                        <input type="text" id="addItemName" name="name" class="form-control" placeholder="Enter item name" required />
                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">
                        <label for="addItemQuantity" class="form-label">Quantity</label>
                        <input type="number" id="addItemQuantity" name="quantity" class="form-control" min="0" placeholder="Enter quantity" required />
                    </div>


                    <!-- Price -->
                    <div class="mb-3">
                        <label for="addItemPrice" class="form-label">Price</label>
                        <div class="input-group">
                            <span class="input-group-text">RM</span>
                            <input type="number" id="addItemPrice" name="price" class="form-control" min="0" step="0.01" placeholder="0.00" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-warning text-dark fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        new DataTable('#inventoryTable');

        const editItemModal = document.getElementById('editItemModal');

        editItemModal.addEventListener('show.bs.modal', function (event) {

            const button = event.relatedTarget;

            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const quantity = button.getAttribute('data-quantity');
            const price = button.getAttribute('data-price');

            document.getElementById('editItemId').value = id;
            document.getElementById('editItemName').value = name;
            document.getElementById('editItemQuantity').value = quantity;
            document.getElementById('editItemPrice').value = price;

        });

    </script>
}