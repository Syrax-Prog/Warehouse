
<header class="navbar navbar-dark bg-dark border-bottom border-3 border-warning sticky-top">
    <div class="container-fluid px-4 py-2">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-page="/Dashboard/Dashboard">

            <i class="bi bi-boxes fs-4 text-warning"></i>

            <span class="text-uppercase" style="letter-spacing: 0.05em;">
                Warehouse
            </span>
        </a>


        <!-- User -->
        <div class="dropdown">

            <button class="btn btn-dark d-flex align-items-center gap-2 border-0" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">

                <!-- Avatar -->
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center"
                     style="width: 36px; height: 36px;">

                    <i class="bi bi-person-fill"></i>

                </div>

                <!-- User information -->
                <div class="text-start d-none d-sm-block">

                    <div class="text-white fw-semibold">
                        @Context.Session.GetString("name")
                    </div>

                    <small class="text-secondary">
                        @Context.Session.GetString("email")
                    </small>

                </div>

                <i class="bi bi-chevron-down text-secondary"></i>

            </button>


            <!-- Dropdown -->
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <a class="dropdown-item text-danger" asp-page="/Login/Login" asp-page-handler="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </div>
</header>